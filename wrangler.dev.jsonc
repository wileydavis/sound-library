{
  // Local testing only: `npm run dev`. No Access, fake AI, local D1/R2.
  "name": "sound-library-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sound-library" }],
  "d1_databases": [{ "binding": "DB", "database_name": "sound-library", "database_id": "local-dev" }],
  "vars": { "ALLOW_UNAUTHENTICATED": "true", "DEV_FAKE_AI": "true" }
}
